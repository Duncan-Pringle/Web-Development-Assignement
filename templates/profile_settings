{% extends 'profile_base.html' %}
{% set active_page = 'settings' %}

{% block profile_main_content %}
<section class="profile-section">
    <h3>Account Management</h3>
    
    <div class="settings-item">
        <h4>Change Username</h4>
        <form action="/update-username" method="POST">
            <input type="text" name="new_username" placeholder="New username" required>
            <button type="submit" class="btn btn-small">Update</button>
        </form>
    </div>

    <div class="settings-item">
        <h4>Change Password</h4>
        <form action="/update-password" method="POST">
            <input type="password" name="old_password" placeholder="Current password" required>
            <input type="password" name="new_password" placeholder="New password" required>
            <button type="submit" class="btn btn-small">Change Password</button>
        </form>
    </div>

    <div class="danger-zone" style="margin-top: 50px; padding: 20px; border: 1px dashed #e74c3c; border-radius: 8px;">
        <h4 style="color: #e74c3c;">Danger Zone</h4>
        <p style="font-size: 0.85rem; color: #666;">Once you delete your account, all your data will be permanently removed.</p>
        <form action="/delete-account" method="POST" onsubmit="return confirm('Are you sure? This cannot be undone.');">
            <button type="submit" class="btn danger" style="background-color: #e74c3c;">Delete Account</button>
        </form>
    </div>
</section>

<style>
    .settings-item { margin-bottom: 30px; }
    .settings-item form { display: flex; gap: 10px; margin-top: 10px; }
    .settings-item input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; flex-grow: 1; max-width: 300px; }
</style>
{% endblock %}