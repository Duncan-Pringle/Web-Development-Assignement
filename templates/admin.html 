{% extends "base.html" %}

{% block title %}Admin Panel{% endblock %}

{% block content %}

{% include 'header.html' %}

<div class="admin-container">

    <h1>Admin Dashboard</h1>

    <!-- Stats -->
    <div class="admin-stats">
        <div class="stat-card">Users: {{ users|length }}</div>
        <div class="stat-card">Movies: {{ movies|length }}</div>
    </div>

    <!-- USERS TABLE -->
    <h2>Manage Users</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Level</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.userid }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.userlevel }}</td>

                <td>
                    <a href="/admin/promote/{{ user.userid }}" class="btn-small">Promote</a>
                    <a href="/admin/delete_user/{{ user.userid }}" class="btn-small danger">Delete</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <br><br>

    <!-- MOVIES TABLE -->
    <h2>Movies in Database</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Year</th>
                <th>Rating</th>
            </tr>
        </thead>

        <tbody>
            {% for movie in movies %}
            <tr>
                <td>{{ movie.movieid }}</td>
                <td>{{ movie.title }}</td>
                <td>{{ movie.year }}</td>
                <td>{{ movie.rating }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</div>

{% endblock %}